# Mặc định trỏ về cổng backend 8080.
VITE_BACKEND_URL=http://127.0.0.1:8080

# =========================================================================
# CẤU HÌNH THANH TOÁN VIETQR (DỄ DÀNG ĐỔI THÀNH QR RIÊNG CỦA TỪNG THÀNH VIÊN)
# =========================================================================
# Mã ngân hàng (techcombank, mbbank, vcb, icb, acb, tpb, vpb, bidv, ...)
VIETQR_BANK_ID=techcombank

# Số tài khoản ngân hàng nhận tiền
VIETQR_ACCOUNT_NO=8888332999

# Tên chủ tài khoản ngân hàng (hiển thị trên mã QR)
VIETQR_ACCOUNT_NAME="DAO NGOC THINH"

# Mẫu giao diện hiển thị mã QR (compact2, compact, qr_only, print)
VIETQR_TEMPLATE=compact2
